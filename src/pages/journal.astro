---
// The Journal is now the Library: old links and bookmarks to /journal/ land there
const to = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}library/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Library · Mark T</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </head>
  <body style="margin:0;background:#fafafa"></body>
</html>
