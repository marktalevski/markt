---
import Base from '../layouts/Base.astro';
import Sound from '../components/Sound.jsx';
---
<Base title="Sound · Mark T">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Michroma&amp;family=Hanken+Grotesk:wght@400;500&amp;family=JetBrains+Mono:wght@300;400;500&amp;display=swap" />
    <style is:inline>
      /* the paper colour the other pages hand over on, so nothing flashes before the canvas draws */
      html,body{margin:0;height:100%;overflow:hidden;background:#f5f3ee}
      /* sideways drags are the page's own (they move the playhead on a phone), not the browser's; up and down and pinching still work */
      body{touch-action:pan-y pinch-zoom}
      a{color:inherit}a:hover{color:inherit;opacity:.6}nav a:hover{opacity:1}
    </style>
  </Fragment>
  <Sound client:only="react" />
</Base>
