---
// Freediving: the markup the page starts from. freediving/main.js builds the entries and runs it; freediving/freediving.css styles it.
import Base from '../layouts/Base.astro';
import PageMenu from '../components/PageMenu.astro';
import '../freediving/freediving.css';
---

<Base title="Freediving · Mark T">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&amp;family=JetBrains+Mono:wght@300;400;500&amp;display=swap" />
  </Fragment>
  <div class="freediving">
    <canvas class="freediving__water"></canvas>
    <canvas class="freediving__surface"></canvas>
    <div class="world"></div>
    <PageMenu current="freediving" currentLabel="Freediving, current page, back to the surface" />
    <div class="chrome">
      <div class="chrome__box">
        <div class="chrome__depth">0.0 m</div>
        <div class="chrome__counter"></div>
      </div>
    </div>
  </div>
  <script>
    import '../freediving/main.js';
  </script>
</Base>
