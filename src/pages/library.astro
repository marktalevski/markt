---
// The Library: the markup the page starts from. library/main.js fills in the books and the text and runs it; library/library.css styles it.
import Base from '../layouts/Base.astro';
import PageMenu from '../components/PageMenu.astro';
import '../library/library.css';
import { DOT_KEYS, DOT_CSS, dotRadius } from '../lib/nav.js';
---

<Base title="Library · Mark T">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&amp;family=Geist:wght@300..700&amp;family=Geist+Mono:wght@400;500&amp;display=swap" />
  </Fragment>
  <div class="library">
    <div class="reading" data-read="1"><div class="reading__text"></div></div>
    <div class="rail" data-rail="1"><span class="rail__marker" aria-hidden="true"></span></div>
    <div data-books></div>
    {DOT_KEYS.map(key => <span class="fly-dot" data-fly={key} data-navdot="1" aria-hidden="true" style={`--dot:${DOT_CSS[key]};--d:${2 * dotRadius(key)}px`} />)}
    <div class="library__fade" aria-hidden="true"></div>
  </div>
  <PageMenu current="library" />
  <template id="mug"><span class="mug" aria-hidden="true" data-mug="1"><span class="mug__steam"></span><span class="mug__steam"></span><span class="mug__steam"></span><span class="mug__cup"><span class="mug__handle"></span><span class="mug__body"></span><span class="mug__shine"></span><span class="mug__torii"><span></span><span></span><span></span><span></span><span></span></span></span></span></template>
  <script>
    import '../library/main.js';
  </script>
</Base>
