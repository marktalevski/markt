---
interface Props { title: string; noindex?: boolean }
const { title, noindex } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
    <script is:inline>
      // The pages animate their way out before navigating. When Back restores one from the back-forward cache
      // it would resume with that exit already finished (a blank page), so start it fresh instead.
      addEventListener('pageshow', e => { if (e.persisted) location.reload(); });
      // Every page is a canvas that draws nothing until its script has started, so between two pages there would be a blank moment. So a
      // page leaves through __leave: it keeps a picture of its last frame (its canvases, and its menu dots), and the next page shows that
      // picture straight away, until it has drawn its own first frames (see the script at the top of the body)
      window.__leave = href => {
        try { const W = innerWidth, H = innerHeight, c = document.createElement('canvas'); c.width = W; c.height = H; const x = c.getContext('2d');
          x.fillStyle = getComputedStyle(document.body).backgroundColor || '#f5f3ee'; x.fillRect(0, 0, W, H);
          document.querySelectorAll('canvas').forEach(cv => { const r = cv.getBoundingClientRect(), st = getComputedStyle(cv); if (!r.width || !r.height || st.display === 'none' || st.visibility === 'hidden') return;
            x.globalAlpha = +st.opacity; if (x.globalAlpha > 0) try { x.drawImage(cv, r.left, r.top, r.width, r.height); } catch (e) {} });
          x.globalAlpha = 1; document.querySelectorAll('[data-navdot]').forEach(d => { const r = d.getBoundingClientRect(), st = getComputedStyle(d); if (r.width < 3 || +st.opacity === 0 || st.visibility === 'hidden') return;
            x.fillStyle = st.backgroundColor; x.beginPath(); x.arc(r.left + r.width / 2, r.top + r.height / 2, r.width / 2, 0, 6.2832); x.fill(); });
          sessionStorage.setItem('page-cover', JSON.stringify({ t: Date.now(), src: c.toDataURL('image/jpeg', .9) }));
        } catch (e) {}
        location.href = href;
      };
      // Labels are set in Papyrus where it's installed (macOS, iOS, Windows with Office). Elsewhere they go back
      // to the original Newsreader styles, not a plain substitute.
      try {
        const x = document.createElement('canvas').getContext('2d'), w = f => { x.font = '40px ' + f; return x.measureText('Freediving Journal').width; };
        if (w('Papyrus, monospace') === w('monospace') && w('Papyrus, serif') === w('serif')) document.documentElement.classList.add('no-papyrus');
      } catch (e) {}
    </script>
    <style is:inline>
      html.no-papyrus [data-lab="home"] { font-family: 'Newsreader', Georgia, serif !important; font-style: italic !important; font-weight: 300 !important; letter-spacing: -0.01em !important; }
      /* keys whose canvas drawing shows their own hover / pressed state: no browser focus ring on top */
      [data-noring]:focus, [data-noring]:focus-visible { outline: none !important; }
      html.no-papyrus [data-lab="nav"] { font-family: 'Newsreader', Georgia, serif !important; font-weight: 600 !important; }
      /* narrow screens: the page menu's vertical labels are smaller and the menu shorter, so it doesn't take the top of a phone screen */
      @media (max-width: 719px) {
        nav[aria-label="Pages"] > [data-navk] { height: 108px !important; }
        nav[aria-label="Pages"] > [data-navk] > span:last-child { height: 72px !important; }
        nav[aria-label="Pages"] > [data-navk] > span:last-child > span { font-size: 14px !important; }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      // arriving from another page: its last frame, over everything, until this page says it has drawn its own first frame (window.__ready,
      // which each page calls once it has), or at the latest after a few seconds. The picture is decoded before the first paint, so it is
      // there from the very first frame
      window.__ready = () => {};
      try {
        const j = JSON.parse(sessionStorage.getItem('page-cover') || 'null'); sessionStorage.removeItem('page-cover');
        if (j && Date.now() - j.t < 10000) {
          const i = new Image(); i.id = 'page-cover'; i.alt = ''; i.decoding = 'sync'; i.src = j.src; i.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;z-index:2147483000;pointer-events:none;transition:opacity .15s';
          document.body.appendChild(i);
          let gone = false; const off = () => { if (gone) return; gone = true; i.style.opacity = '0'; setTimeout(() => i.remove(), 200); };
          // a frame after the page's own first frame, so that frame is on screen before the cover lifts off it
          window.__ready = () => requestAnimationFrame(() => requestAnimationFrame(off));
          setTimeout(off, 4000);
        }
      } catch (e) {}
    </script>
    <slot />
  </body>
</html>
