---
// The shell every page sits in: the document's head, and the few small scripts that have to run before a page is first painted (so
// they are written into the page itself, not loaded with the page's own code).
import { BASE } from '../lib/base.js';
import fpsMeter from '../lib/fps-meter.js?url&no-inline'; // (the file's address in the site)

interface Props {
  title: string;
  noindex?: boolean;
}
const { title, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <!-- every page's fonts come from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
    <script is:inline>
      // The pages animate their way out before navigating. When Back restores one from the back-forward cache it would resume with
      // that exit already finished (a blank page), so it starts fresh instead.
      addEventListener('pageshow', e => {
        if (e.persisted) location.reload();
      });

      // Labels are set in Papyrus where it is installed (macOS, iOS, Windows with Office). Elsewhere they go back to the original
      // Newsreader styles (.no-papyrus), not to a plain substitute. (A font that isn't there measures the same as its fallback.)
      try {
        const pen = document.createElement('canvas').getContext('2d');
        const width = font => {
          pen.font = '40px ' + font;
          return pen.measureText('Freediving Journal').width;
        };
        if (width('Papyrus, monospace') === width('monospace') && width('Papyrus, serif') === width('serif'))
          document.documentElement.classList.add('no-papyrus');
      } catch (e) {}
    </script>
  </head>
  <body>
    <script is:inline>
      // Arriving from another page of the site: that page's last frame goes over everything (lib/cover.js keeps the picture), until
      // this page says it has drawn its own first frame (pageReady() there, which calls window.__ready) or, at the latest, four
      // seconds on. The script is here, ahead of everything else in the body, so that the picture is decoded before the first paint
      // and is there from the very first frame.
      window.__ready = () => {};
      try {
        const cover = JSON.parse(sessionStorage.getItem('page-cover') || 'null');
        sessionStorage.removeItem('page-cover');
        if (cover && Date.now() - cover.t < 10000) {
          const img = new Image();
          img.id = 'page-cover';
          img.alt = '';
          img.decoding = 'sync';
          img.src = cover.src;
          img.style.cssText =
            'position:fixed;inset:0;width:100%;height:100%;z-index:2147483000;pointer-events:none;transition:opacity .15s';
          document.body.appendChild(img);
          // (pages can style themselves for arriving under the picture)
          document.documentElement.classList.add('covered');

          let lifted = false;
          const lift = () => {
            if (lifted) return;
            lifted = true;
            img.style.opacity = '0';
            setTimeout(() => img.remove(), 200);
          };
          // a frame after the page's own first frame, so that frame is on screen before the cover lifts off it
          window.__ready = () => requestAnimationFrame(() => requestAnimationFrame(lift));
          setTimeout(lift, 4000);
        }
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ fpsMeter }}>
      // The frame meter (lib/fps-meter.js): ?fps at the end of any page's address turns it on, and it stays on from page to page
      // until ?fps=0 turns it off. Its code is only fetched while it is on.
      try {
        const asked = new URLSearchParams(location.search).get('fps');
        if (asked !== null) sessionStorage.setItem('fps-meter', asked === '0' ? '' : '1');
        if (sessionStorage.getItem('fps-meter')) import(fpsMeter).then(meter => meter.startFpsMeter());
      } catch (e) {}
    </script>
    <slot />
  </body>
</html>
